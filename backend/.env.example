# Supabase project: gymplus-backend (zjcxdqlifimnezxuzulc)
NEXT_PUBLIC_SUPABASE_URL=https://zjcxdqlifimnezxuzulc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_qoRNn9d4ez3Fu22JpzacNw_R9AIF5Pq

# Service role key — server-only, NEVER expose to the client or commit
# a real value. Copy it from Supabase dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron auth: /api/cron/* checks this instead of a user session.
# Generate any random string and configure the same value in Vercel's
# environment variables (Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET` once set).
CRON_SECRET=

# WhatsApp Cloud API (Meta) — optional. Without these, sendWhatsapp()
# and the /api/webhooks/whatsapp verification just log and no-op.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Google Sheets (funil quente/frio) — optional. As planilhas já são
# públicas ("qualquer pessoa com o link pode ver"), então o import lê o
# CSV exportado direto, sem credencial nenhuma. Só defina estas variáveis
# se as planilhas de origem mudarem — os IDs atuais já vêm com fallback
# hardcoded em lib/integrations/sheets.ts.
GOOGLE_SHEETS_QUENTE_ID=
GOOGLE_SHEETS_FRIO_ID=

# Webhook em tempo real: /api/leads/webhook checa este segredo em vez de
# sessão de usuário (chamado pelo Apps Script instalado em cada planilha,
# não pelo navegador). Gere qualquer string aleatória e configure o mesmo
# valor no Vercel e no script de cada planilha (Authorization: Bearer $LEADS_WEBHOOK_SECRET).
LEADS_WEBHOOK_SECRET=

# E-mail (Resend) — optional. Without it, sendEmail() just logs.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Anthropic (Claude) — optional. Powers the AI call-analysis in the
# "SDR Liga GFB" call widget (/api/ai/analyze-call). Without it, calls
# are still logged and transcribed, just without the AI summary/score.
ANTHROPIC_API_KEY=
