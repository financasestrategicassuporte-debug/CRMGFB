# Supabase project: gymplus-backend (zjcxdqlifimnezxuzulc)
NEXT_PUBLIC_SUPABASE_URL=https://zjcxdqlifimnezxuzulc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_qoRNn9d4ez3Fu22JpzacNw_R9AIF5Pq

# Service role key — server-only, NEVER expose to the client or commit
# a real value. Copy it from Supabase dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron auth: /api/cron/* checks this instead of a user session.
# Generate any random string and configure the same value in Vercel's
# environment variables (Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET` once set).
CRON_SECRET=

# WhatsApp Cloud API (Meta) — optional. Without these, sendWhatsapp()
# and the /api/webhooks/whatsapp verification just log and no-op.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Google Sheets (funil quente/frio) — optional. Without these,
# GET /api/leads/import returns an empty list instead of erroring.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# E-mail (Resend) — optional. Without it, sendEmail() just logs.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
